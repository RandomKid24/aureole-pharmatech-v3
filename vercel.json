{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "aureolepharmatech.com"
        }
      ],
      "destination": "https://www.aureolepharmatech.com/:path*",
      "permanent": true
    },
    {
      "source": "/products/stability-chamber/:path*",
      "destination": "/products/stability-chambers/:path*",
      "permanent": true
    },
    {
      "source": "/products/stability-chamber",
      "destination": "/products/stability-chambers/",
      "permanent": true
    },
    { "source": "/stability-chambers-catalogue-form", "destination": "/products/stability-chambers/", "permanent": true },
    { "source": "/stability-chambers-catalogue-form/", "destination": "/products/stability-chambers/", "permanent": true },
    { "source": "/process-equipments-catalogue-form", "destination": "https://aureoleproequip.com/our-products.html", "permanent": true },
    { "source": "/process-equipments-catalogue-form/", "destination": "https://aureoleproequip.com/our-products.html", "permanent": true },
    { "source": "/table-top-instruments-catalogue-form", "destination": "/products/table-top-instruments/", "permanent": true },
    { "source": "/table-top-instruments-catalogue-form/", "destination": "/products/table-top-instruments/", "permanent": true },
    { "source": "/microbial-air-sampler-catalogue-form", "destination": "/products/air-sampler/", "permanent": true },
    { "source": "/microbial-air-sampler-catalogue-form/", "destination": "/products/air-sampler/", "permanent": true },
    { "source": "/pump-series-catalogue-form", "destination": "/products", "permanent": true },
    { "source": "/pump-series-catalogue-form/", "destination": "/products", "permanent": true },
    { "source": "/aluminium-ropp-caps-form", "destination": "/products", "permanent": true },
    { "source": "/aluminium-ropp-caps-form/", "destination": "/products", "permanent": true },
    { "source": "/contact-us/", "destination": "/#contact", "permanent": true },
    { "source": "/contact-us", "destination": "/#contact", "permanent": true },
    { "source": "/contact/", "destination": "/#contact", "permanent": true },
    { "source": "/contact", "destination": "/#contact", "permanent": true },
    { "source": "/about-us/", "destination": "/about/", "permanent": true },
    { "source": "/about-us", "destination": "/about/", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/home/", "destination": "/", "permanent": true },
    {
      "source": "/vcards/:slug",
      "destination": "/vcards/:slug/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdn.express-chat.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' https://hrms.encryptedbar.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.express-chat.com; frame-src 'self' https://www.google.com https://www.youtube.com; frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/anatomy/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/vcards/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*).(webp|png|jpg|jpeg|gif|mp4|lottie|woff|woff2|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/vcards/:path*/",
      "destination": "/vcards-2026/:path*"
    },
    {
      "source": "/vcards/:path*",
      "destination": "/vcards-2026/:path*"
    },
    {
      "source": "/envato/digi-vcard/CEO/:path*",
      "destination": "/vcards-2026/aarti-avhad/:path*"
    }
  ]
}